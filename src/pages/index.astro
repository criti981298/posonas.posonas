
---
import MainLayout from "../layouts/MainLayout.astro";

import Hero from "../components/Hero.astro";
import EventsSection from "../components/EventsSection.astro";
import ResourcesSection from "../components/ResourcesSection.astro";

const descripcion =
  "Un espacio para conectar, expresarnos y celebrar nuestra diversidad.";
---

<MainLayout
  title="Posonas | Nuestra comunidad"
  description={descripcion}
>

  <!-- ==========================================
       CONTENIDO PRINCIPAL
       ========================================== -->

  <main id="contenido-principal">

    <!-- ==========================================
         HERO PRINCIPAL
         ========================================== -->

    <Hero />


    <!-- ==========================================
         SECCIÓN COMUNIDAD
         ========================================== -->

    <section id="comunidad">

      <div class="comunidad-contenido">

        <h2>Un espacio para ser tú</h2>

        <p>
          Estamos construyendo algo especial.
          Próximamente encontrarás eventos,
          recursos y espacios de comunidad.
        </p>

      </div>

    </section>


    <!-- ==========================================
         SECCIÓN EVENTOS
         ========================================== -->

    <EventsSection />


    <!-- ==========================================
         SECCIÓN RECURSOS
         ========================================== -->

    <ResourcesSection />

  </main>

</MainLayout>


<!-- ==========================================
     ESTILOS DE LA SECCIÓN COMUNIDAD
     ========================================== -->

<style>

  #comunidad {
    padding: 100px 25px;
    text-align: center;
    background: var(--color-background);
  }

  .comunidad-contenido {
    max-width: 850px;
    margin: 0 auto;
  }

  #comunidad h2 {
    font-family: var(--font-heading);
    font-size: clamp(28px, 5vw, 45px);
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 25px;
  }

  #comunidad p {
    max-width: 600px;
    margin: 0 auto;
    font-family: var(--font-body);
    font-size: 19px;
    line-height: 1.7;
    color: var(--color-text-muted);
  }

  @media (max-width: 768px) {

    #comunidad {
      padding: 80px 20px;
    }

    #comunidad p {
      font-size: 16px;
    }

  }

</style>


<!-- ==========================================
     ANIMACIONES GSAP
     ========================================== -->

<script>

  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  // Registrar ScrollTrigger
  gsap.registerPlugin(ScrollTrigger);


  function iniciarAnimaciones() {

    // ==========================================
    // CONFIGURACIÓN DE ACCESIBILIDAD
    // ==========================================

    const reducirMovimiento = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    ).matches;

    if (reducirMovimiento) {
      return;
    }


    // ==========================================
    // ANIMACIÓN DE LA SECCIÓN COMUNIDAD
    // ==========================================

    const comunidad = document.querySelector(
      ".comunidad-contenido"
    );

    if (comunidad) {

      gsap.from(comunidad.children, {

        opacity: 0,

        y: 60,

        duration: 1,

        stagger: 0.2,

        ease: "power3.out",

        clearProps: "all",

        scrollTrigger: {

          trigger: comunidad,

          start: "top 85%",

          once: true

        }

      });

    }

  }


  // ==========================================
  // INICIAR ANIMACIONES
  // ==========================================

  iniciarAnimaciones();

</script>
