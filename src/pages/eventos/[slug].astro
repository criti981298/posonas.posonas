
---
import MainLayout from "../../layouts/MainLayout.astro";
import { eventos } from "../../data/eventos";
import type { Evento } from "../../data/eventos";

export function getStaticPaths() {
  return eventos.map((evento) => ({
    params: {
      slug: evento.slug
    },
    props: {
      evento
    }
  }));
}

interface Props {
  evento: Evento;
}

const { evento } = Astro.props;
---

<MainLayout
  title={`${evento.titulo} | Posonas`}
  description={evento.descripcion}
>
  <main class="min-h-screen bg-[#101019] px-6 py-20">

    <article class="mx-auto max-w-4xl">

      <a
        href="/#eventos"
        class="inline-flex items-center gap-2 text-sm font-medium text-fuchsia-300 hover:text-fuchsia-200"
      >
        <span aria-hidden="true">←</span>
        Volver a eventos
      </a>

      <header class="mt-12">

        <span
          class="inline-block rounded-full bg-fuchsia-500/15 px-4 py-2 text-sm font-semibold text-fuchsia-300"
        >
          {evento.categoria}
        </span>

        <h1
          class="mt-6 text-4xl font-extrabold leading-tight text-white md:text-6xl"
        >
          {evento.titulo}
        </h1>

        <p class="mt-6 text-lg leading-8 text-zinc-300">
          {evento.descripcion}
        </p>

      </header>

      <section
        class="mt-12 grid gap-5 rounded-2xl border border-white/10 bg-white/5 p-6 md:grid-cols-3"
        aria-label="Información del evento"
      >
        <div>
          <h2 class="text-sm font-semibold text-fuchsia-300">
            Fecha
          </h2>
          <p class="mt-2 text-white">{evento.fecha}</p>
        </div>

        <div>
          <h2 class="text-sm font-semibold text-fuchsia-300">
            Horario
          </h2>
          <p class="mt-2 text-white">{evento.horario}</p>
        </div>

        <div>
          <h2 class="text-sm font-semibold text-fuchsia-300">
            Ubicación
          </h2>
          <p class="mt-2 text-white">{evento.lugar}</p>
        </div>
      </section>

      <section class="mt-16">
        <h2 class="text-3xl font-bold text-white">
          Sobre este evento
        </h2>

        <p class="mt-6 text-lg leading-9 text-zinc-300">
          {evento.descripcionCompleta}
        </p>
      </section>

      <aside
        class="mt-16 rounded-2xl border border-violet-400/20 bg-violet-400/10 p-6"
      >
        <p class="text-sm leading-7 text-zinc-200">
          Este es un evento de demostración.
          La información es ficticia y no representa
          una actividad o inscripción disponible.
        </p>
      </aside>

    </article>

  </main>
</MainLayout>
