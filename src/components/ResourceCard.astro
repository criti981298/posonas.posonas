
---
interface Props {
  titulo: string;
  descripcion: string;
  icono: string;
  categoria: string;
}

const {
  titulo,
  descripcion,
  icono,
  categoria
} = Astro.props;
---

<article
  class="resource-card group rounded-2xl border border-white/10 bg-white/5 p-6 transition-colors duration-300 hover:border-fuchsia-400/30 hover:bg-white/10"
>
  <div
    class="mb-6 flex h-14 w-14 items-center justify-center rounded-xl bg-fuchsia-500/15 text-2xl"
    aria-hidden="true"
  >
    {icono}
  </div>

  <span class="text-xs font-semibold uppercase tracking-widest text-fuchsia-300">
    {categoria}
  </span>

  <h3 class="mt-3 text-2xl font-bold text-white">
    {titulo}
  </h3>

  <p class="mt-4 text-sm leading-7 text-zinc-300">
    {descripcion}
  </p>

  <span class="mt-6 inline-block text-sm font-medium text-violet-300">
    Contenido próximamente
  </span>
</article>
