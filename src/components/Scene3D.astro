---
// Bandera 3D inmersiva y translúcida que ondea y cambia de bandera en cada apartado.
---

<canvas id="escena3d" aria-hidden="true"></canvas>
<div class="issue" aria-hidden="true">
  <span>POSONAS — Nº 001</span>
  <span class="issue__flag">ORGULLO LGBT</span>
  <span class="issue__pct">000</span>
</div>

<style is:global>
  #escena3d { position: fixed; inset: 0; width: 100%; height: 100%; z-index: 0; pointer-events: none; }
  .issue {
    position: fixed; left: 22px; bottom: 20px; z-index: 70; display: flex; gap: 16px;
    font: 600 10px/1 var(--font-body); letter-spacing: .22em; color: #f4b7d4; mix-blend-mode: difference;
    pointer-events: none;
  }
  @media (max-width: 650px) { .issue { display: none; } }
</style>

<script>
  import * as THREE from "three";

  // Cada bandera: [color, peso de la franja]
  const banderas = [
    { n: "ORGULLO LGBT", s: [["#e40303",1],["#ff8c00",1],["#ffed00",1],["#008026",1],["#004dff",1],["#750787",1]] },
    { n: "BISEXUAL", s: [["#d60270",2],["#9b4f96",1],["#0038a8",2]] },
    { n: "TRANS", s: [["#5bcefa",1],["#f5a9b8",1],["#ffffff",1],["#f5a9b8",1],["#5bcefa",1]] },
    { n: "LESBIANA", s: [["#d52d00",1],["#ef7627",1],["#ff9a56",1],["#ffffff",1],["#d162a4",1],["#b55690",1],["#a30262",1]] },
    { n: "PANSEXUAL", s: [["#ff218c",1],["#ffd800",1],["#21b1ff",1]] },
  ] as { n: string; s: [string, number][] }[];

  const FILAS = 210; // divisible entre 3, 5, 6 y 7
  const textura = (s: [string, number][]) => {
    const total = s.reduce((a, [, w]) => a + w, 0);
    const data = new Uint8Array(FILAS * 4);
    let fila = 0;
    s.forEach(([hex, w]) => {
      const c = new THREE.Color(hex);
      for (let k = 0; k < (FILAS / total) * w; k++, fila++) {
        data.set([c.r, c.g, c.b].map((v) => Math.round(v * 255)), fila * 4);
        data[fila * 4 + 3] = 255;
      }
    });
    const t = new THREE.DataTexture(data, 1, FILAS, THREE.RGBAFormat);
    t.colorSpace = THREE.SRGBColorSpace; t.minFilter = t.magFilter = THREE.NearestFilter; t.needsUpdate = true;
    return t;
  };

  const canvas = document.getElementById("escena3d") as HTMLCanvasElement | null;
  const pct = document.querySelector<HTMLElement>(".issue__pct");
  const nombre = document.querySelector<HTMLElement>(".issue__flag");
  const reducir = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const suave = (x: number) => x * x * (3 - 2 * x);

  try {
    if (!canvas) throw new Error("sin canvas");
    const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true });
    renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(35, 1, 0.1, 50);
    camera.position.z = 7;

    const texs = banderas.map((b) => textura(b.s));
    const mat = new THREE.ShaderMaterial({
      transparent: true, depthWrite: false, side: THREE.DoubleSide,
      uniforms: { uTime: { value: 0 }, uMix: { value: 0 }, uA: { value: texs[0] }, uB: { value: texs[1] }, uOp: { value: 0.42 } },
      vertexShader: `
        uniform float uTime; varying vec2 vUv; varying float vW;
        void main(){
          vUv = uv; vec3 p = position;
          float ph = p.x*1.1 + uTime*1.3 + p.y*.5;
          float w = sin(ph)*.45 + sin(p.x*2.3 - uTime*1.7 + p.y*1.1)*.16;
          float k = .25 + .75*uv.x;
          p.z += w*k; vW = cos(ph)*uv.x;
          gl_Position = projectionMatrix*modelViewMatrix*vec4(p,1.);
        }`,
      fragmentShader: `
        uniform sampler2D uA, uB; uniform float uMix, uOp; varying vec2 vUv; varying float vW;
        void main(){
          vec2 st = vec2(.5, 1. - vUv.y);
          float edge = uMix*1.4 - .2;
          float m = 1. - smoothstep(edge-.15, edge+.15, vUv.x);
          vec3 c = mix(texture2D(uA, st).rgb, texture2D(uB, st).rgb, m);
          c *= .78 + .36*vW;
          float f = smoothstep(0.,.08,vUv.x)*smoothstep(1.,.92,vUv.x)*smoothstep(0.,.12,vUv.y)*smoothstep(1.,.88,vUv.y);
          gl_FragColor = vec4(c, uOp*f);
          #include <colorspace_fragment>
        }`,
    });
    const bandera = new THREE.Mesh(new THREE.PlaneGeometry(10, 6.2, 90, 50), mat);
    scene.add(bandera);

    const o = { x: 0, y: 0 }, m = { x: 0, y: 0 };
    addEventListener("pointermove", (e) => { o.x = e.clientX / innerWidth - 0.5; o.y = e.clientY / innerHeight - 0.5; });
    const ajustar = () => {
      renderer.setSize(innerWidth, innerHeight, false);
      camera.aspect = innerWidth / innerHeight; camera.updateProjectionMatrix();
      mat.uniforms.uOp.value = innerWidth < 800 ? 0.36 : 0.42;
    };
    addEventListener("resize", ajustar); ajustar();

    const secciones = [".hero", "#comunidad", "#manifiesto", "#eventos", "#recursos"]
      .map((q) => document.querySelector<HTMLElement>(q)).filter(Boolean) as HTMLElement[];

    const dibujar = (t: number) => {
      const max = Math.max(1, document.documentElement.scrollHeight - innerHeight);
      const p = Math.min(1, Math.max(0, scrollY / max));
      m.x += (o.x - m.x) * 0.06; m.y += (o.y - m.y) * 0.06;

      // ¿En qué apartado estamos y cuánto falta para el siguiente?
      const y = scrollY + innerHeight * 0.5;
      const tops = secciones.map((s) => s.getBoundingClientRect().top + scrollY);
      let i = 0; tops.forEach((top, k) => { if (top <= y) i = k; });
      const siguiente = tops[i + 1] ?? Infinity;
      const tr = i + 1 < secciones.length ? suave(Math.min(1, Math.max(0, 1 - (siguiente - y) / (innerHeight * 0.4)))) : 0;
      mat.uniforms.uA.value = texs[i % texs.length];
      mat.uniforms.uB.value = texs[(i + 1) % texs.length];
      mat.uniforms.uMix.value = tr;
      if (nombre) nombre.textContent = banderas[(tr > 0.5 ? i + 1 : i) % banderas.length].n;
      if (pct) pct.textContent = String(Math.round(p * 100)).padStart(3, "0");

      mat.uniforms.uTime.value = t / 1000;
      bandera.rotation.set(-0.12 + m.y * 0.25, -0.35 + Math.sin(p * Math.PI * 2) * 0.3 + m.x * 0.45, Math.sin(p * Math.PI * 3) * 0.06);
      bandera.position.set(Math.sin(p * Math.PI * 4) * 0.9, 0.3 - p * 0.5, 0);
      renderer.render(scene, camera);
    };

    if (reducir) { dibujar(0); addEventListener("scroll", () => dibujar(0), { passive: true }); }
    else renderer.setAnimationLoop(dibujar);
  } catch {
    canvas?.remove();
  }
</script>
