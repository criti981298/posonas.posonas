---
// Escena 3D inmersiva fija: una cinta iridiscente que viaja con el scroll y reacciona al cursor.
---

<canvas id="escena3d" aria-hidden="true"></canvas>
<div class="issue" aria-hidden="true">
  <span>POSONAS — Nº 001</span>
  <span class="issue__pct">000</span>
</div>

<style is:global>
  #escena3d { position: fixed; inset: 0; width: 100%; height: 100%; z-index: 0; pointer-events: none; }
  .issue {
    position: fixed; left: 22px; bottom: 20px; z-index: 70; display: flex; gap: 14px;
    font: 600 10px/1 var(--font-body); letter-spacing: .22em; color: #f4b7d4; mix-blend-mode: difference;
    pointer-events: none;
  }
  @media (max-width: 650px) { .issue { display: none; } #escena3d { opacity: .6; } }
</style>

<script>
  import * as THREE from "three";
  import { RoomEnvironment } from "three/examples/jsm/environments/RoomEnvironment.js";

  const canvas = document.getElementById("escena3d") as HTMLCanvasElement | null;
  const pct = document.querySelector<HTMLElement>(".issue__pct");
  const reducir = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  try {
    if (!canvas) throw new Error("sin canvas");
    const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.toneMapping = THREE.ACESFilmicToneMapping;

    const scene = new THREE.Scene();
    scene.environment = new THREE.PMREMGenerator(renderer).fromScene(new RoomEnvironment(), 0.04).texture;
    const camera = new THREE.PerspectiveCamera(35, 1, 0.1, 50);
    camera.position.z = 7;

    const rosa = new THREE.PointLight(0xf472b6, 60, 20); rosa.position.set(-4, 2, 4);
    const azul = new THREE.PointLight(0x5ed4ff, 50, 20); azul.position.set(4, -2, 4);
    scene.add(rosa, azul);

    const cinta = new THREE.Mesh(
      new THREE.TorusKnotGeometry(1, 0.34, 240, 36, 2, 3),
      new THREE.MeshPhysicalMaterial({
        color: 0xd9a8ff, metalness: 0.85, roughness: 0.16,
        iridescence: 1, iridescenceIOR: 1.7, clearcoat: 1, clearcoatRoughness: 0.1,
      })
    );
    scene.add(cinta);

    const m = { x: 0, y: 0 }; // cursor suavizado
    const o = { x: 0, y: 0 }; // cursor objetivo
    addEventListener("pointermove", (e) => { o.x = e.clientX / innerWidth - 0.5; o.y = e.clientY / innerHeight - 0.5; });

    const ajustar = () => {
      renderer.setSize(innerWidth, innerHeight, false);
      camera.aspect = innerWidth / innerHeight;
      camera.updateProjectionMatrix();
    };
    addEventListener("resize", ajustar); ajustar();

    const dibujar = (t: number) => {
      const max = Math.max(1, document.documentElement.scrollHeight - innerHeight);
      const p = Math.min(1, Math.max(0, scrollY / max));
      m.x += (o.x - m.x) * 0.06; m.y += (o.y - m.y) * 0.06;
      const ancho = innerWidth < 800 ? 0.4 : 2.1;
      cinta.position.x = -ancho * Math.cos(p * Math.PI * 3) + m.x * 0.6;
      cinta.position.y = (0.5 - p * 1.1) + Math.sin(t / 1800) * 0.12 - m.y * 0.4;
      cinta.rotation.set(p * 5 + m.y * 1.2, p * 9 + t / 9000 + m.x * 1.6, p * 2);
      cinta.scale.setScalar((innerWidth < 800 ? 0.7 : 1.1) + Math.sin(p * Math.PI) * 0.35);
      if (pct) pct.textContent = String(Math.round(p * 100)).padStart(3, "0");
      renderer.render(scene, camera);
    };

    if (reducir) {
      dibujar(0);
      addEventListener("scroll", () => dibujar(0), { passive: true });
    } else {
      renderer.setAnimationLoop(dibujar);
    }
  } catch {
    canvas?.remove(); // sin WebGL: el sitio sigue funcionando con su diseño actual
  }
</script>
