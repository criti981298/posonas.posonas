
---
import EventCard from "./EventCard.astro";

const eventos = [
  {
    titulo: "Encuentro comunitario",
    categoria: "Convivencia",
    fecha: "24 OCT 2026",
    descripcion: "Un espacio de encuentro para compartir experiencias y crear nuevas conexiones."
  },
  {
    titulo: "Noche de arte queer",
    categoria: "Arte y cultura",
    fecha: "31 OCT 2026",
    descripcion: "Una celebración de la creatividad y las distintas expresiones artísticas."
  },
  {
    titulo: "Círculo de conversación",
    categoria: "Comunidad",
    fecha: "07 NOV 2026",
    descripcion: "Un espacio de diálogo respetuoso, escucha y participación comunitaria."
  }
];
---

<section id="eventos" class="bg-[#101019] px-6 py-24">
  <div class="mx-auto max-w-6xl">

    <div class="mb-12 max-w-2xl">
      <span class="text-sm font-semibold tracking-[0.2em] text-fuchsia-300">
        CONECTA · PARTICIPA · CELEBRA
      </span>

      <h2 class="mt-5 text-4xl font-bold text-white md:text-6xl">
        Próximos <span class="text-violet-400">eventos</span>
      </h2>

      <p class="mt-5 text-lg text-zinc-300">
        Descubre actividades y espacios para compartir.
        Estamos preparando nuevas experiencias para nuestra comunidad.
      </p>
    </div>

    <div id="eventos-grid" class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {eventos.map((evento) => (
        <EventCard {...evento} />
      ))}
    </div>

    <p class="mt-8 text-sm text-zinc-400">
      Eventos de demostración. Las fechas y actividades son ficticias.
    </p>

  </div>
</section>


<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  function iniciarAnimacionEventos() {
    const contenedor = document.querySelector("#eventos-grid");

    if (!contenedor) {
      console.warn("Posonas: no se encontró eventos-grid");
      return;
    }

    const tarjetas = contenedor.querySelectorAll(".event-card");

    console.log("Tarjetas de eventos encontradas:", tarjetas.length);

    if (tarjetas.length === 0) return;

    const reducirMovimiento = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    ).matches;

    if (reducirMovimiento) return;

    gsap.from(tarjetas, {
      opacity: 0,
      y: 60,
      duration: 1,
      stagger: 0.2,
      ease: "power3.out",
      clearProps: "all",

      scrollTrigger: {
        trigger: contenedor,
        start: "top 90%",
        once: true
      }
    });

    ScrollTrigger.refresh();
  }

  iniciarAnimacionEventos();
</script>

