
---
import EventCard from "./EventCard.astro";
import EditorialBackdrop from "./EditorialBackdrop.astro";
import { eventos } from "../data/eventos";
---

<section id="eventos" class="bg-[#101019] px-6 py-24">
  <EditorialBackdrop src="/comunidad/Retrato cinematográfico con tela multicolor.png" variant="left" />
  <div class="events-content mx-auto max-w-6xl">

    <div class="events-heading mb-12 max-w-2xl">
      <span class="text-sm font-semibold tracking-[0.2em] text-fuchsia-300">
        CONECTA · PARTICIPA · CELEBRA
      </span>

      <h2 class="mt-5 text-4xl font-bold text-white md:text-6xl">
        Próximos <span class="text-violet-400">eventos</span>
      </h2>

      <p class="mt-5 text-lg text-zinc-300">
        Descubre actividades y espacios para compartir.
        Estamos preparando nuevas experiencias para nuestra comunidad.
      </p>
    </div>

    <div
      id="eventos-grid"
      class="grid gap-6 md:grid-cols-2 lg:grid-cols-3"
    >
      {eventos.map((evento) => (
        <EventCard {...evento} />
      ))}
    </div>

    <p class="mt-8 text-sm text-zinc-400">
      Eventos de demostración. Las fechas y actividades son ficticias.
    </p>

  </div>
</section>

<style>
  #eventos { position: relative; isolation: isolate; }
  .events-content { position: relative; z-index: 2; }
  .events-heading { margin-left: 50%; min-height: 370px; padding-top: 60px; }
  .events-heading h2 { font-size: clamp(38px, 5vw, 72px); line-height: 1.05; letter-spacing: -.04em; }
  @media (max-width: 768px) {
    .events-heading { margin-left: 0; min-height: 420px; padding-top: 190px; }
    .events-heading p { text-shadow: 0 2px 14px #101019; }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  function iniciarAnimacionEventos() {
    const contenedor = document.querySelector("#eventos-grid");

    if (!contenedor) return;

    const tarjetas = contenedor.querySelectorAll(".event-card");

    if (tarjetas.length === 0) return;

    const reducirMovimiento = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    ).matches;

    if (reducirMovimiento) return;

    gsap.from(tarjetas, {
      opacity: 0,
      y: 60,
      duration: 1,
      stagger: 0.2,
      ease: "power3.out",
      clearProps: "all",

      scrollTrigger: {
        trigger: contenedor,
        start: "top 90%",
        once: true
      }
    });
  }

  iniciarAnimacionEventos();
</script>
