
---
import type { Evento } from "../data/eventos";

type Props = Pick<
  Evento,
  "slug" | "titulo" | "categoria" | "fecha" | "descripcion"
>;

const {
  slug,
  titulo,
  categoria,
  fecha,
  descripcion
} = Astro.props;
---

<article
  class="event-card rounded-2xl border border-white/10 bg-white/5 p-6 transition-colors duration-300 hover:bg-white/10"
>
  <span
    class="inline-block rounded-full bg-fuchsia-500/15 px-3 py-1 text-xs font-semibold text-fuchsia-300"
  >
    {categoria}
  </span>

  <p class="mt-6 text-sm font-semibold tracking-widest text-violet-300">
    {fecha}
  </p>

  <h3 class="mt-3 text-2xl font-bold text-white">
    {titulo}
  </h3>

  <p class="mt-3 text-sm leading-7 text-zinc-300">
    {descripcion}
  </p>

  <a
    href={`/eventos/${slug}`}
    class="mt-6 inline-flex items-center gap-2 rounded-full border border-fuchsia-300/40 px-4 py-2 text-sm font-semibold text-fuchsia-200 transition-colors hover:bg-fuchsia-400/10 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-fuchsia-300"
    aria-label={`Ver detalles de ${titulo}`}
  >
    Ver detalles
    <span aria-hidden="true">↗</span>
  </a>
</article>
