
---
interface Props {
  titulo: string;
  categoria: string;
  fecha: string;
  descripcion: string;
}

const { titulo, categoria, fecha, descripcion } = Astro.props;
---

<article class="event-card rounded-2xl border border-white/10 bg-white/5 p-6 transition-colors duration-300 hover:bg-white/10">
  <span class="inline-block rounded-full bg-fuchsia-500/15 px-3 py-1 text-xs font-semibold text-fuchsia-300">
    {categoria}
  </span>

  <p class="mt-6 text-sm font-semibold tracking-widest text-violet-300">
    {fecha}
  </p>

  <h3 class="mt-3 text-2xl font-bold text-white">
    {titulo}
  </h3>

  <p class="mt-3 text-sm leading-7 text-zinc-300">
    {descripcion}
  </p>

  <span class="mt-6 inline-block text-sm font-medium text-fuchsia-300">
    Próximamente
  </span>
</article>
