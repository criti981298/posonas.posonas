---
interface Props { src: string; variant?: "panorama" | "left" | "right"; }
const { src, variant = "right" } = Astro.props;
---

<div class:list={["editorial-art", `editorial-art--${variant}`]} aria-hidden="true">
  <div class="editorial-art__light"></div>
  <div class="editorial-art__depth">
    <img src={src} alt="" loading="lazy" decoding="async" class="editorial-art__image" />
  </div>
</div>

<style>
  .editorial-art {
    position: absolute; top: -65px; right: 0; width: 76%; height: 660px;
    pointer-events: none; perspective: 1200px; z-index: 0;
    overflow: clip;
    mask-image: linear-gradient(to bottom, transparent, #000 14%, #000 65%, transparent 98%), linear-gradient(90deg, transparent, #000 55%, #000 94%, transparent);
    mask-composite: intersect;
  }
  .editorial-art--left { top: 25px; height: 620px; right: auto; left: 0; mask-image: linear-gradient(to bottom, transparent, #000 14%, #000 65%, transparent 98%), linear-gradient(90deg, transparent, #000 8%, #000 45%, transparent 82%); }
  .editorial-art--panorama { width: 100%; height: 100%; top: 0; mask-image: linear-gradient(to bottom, transparent, #000 14%, #000 76%, transparent); }
  .editorial-art__depth { position: absolute; inset: 0; transform-style: preserve-3d; }
  .editorial-art__image { width: 100%; height: 100%; object-fit: cover; transform: translateZ(45px); mix-blend-mode: lighten; }
  .editorial-art--right img { object-position: right center; }
  .editorial-art--left img { object-position: left top; }
  .editorial-art--left .editorial-art__depth { top: 24px; }
  .editorial-art__light { position: absolute; inset: 5%; background: radial-gradient(ellipse, #9b6dff16, transparent 70%); filter: blur(35px); }
  @media (max-width: 768px) {
    .editorial-art { top: -25px; width: 100%; height: 470px; opacity: .55; }
    .editorial-art--left { top: 20px; }
    .editorial-art--panorama { top: 0; height: auto; aspect-ratio: 1672 / 941; opacity: .9; }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);
  document.querySelectorAll<HTMLElement>(".editorial-art").forEach((art) => {
    const section = art.closest("section");
    const depth = art.querySelector<HTMLElement>(".editorial-art__depth");
    const image = art.querySelector("img");
    if (!section || !depth || !image) return;
    const media = gsap.matchMedia();
    media.add("(prefers-reduced-motion: no-preference)", () => {
      gsap.from(depth, { y: 40, duration: 1.4, ease: "power3.out", clearProps: "transform", scrollTrigger: { trigger: art, start: "top 92%", once: true } });
      gsap.to(image, { y: -10, duration: 5, repeat: -1, yoyo: true, ease: "sine.inOut" });
    });
    media.add("(prefers-reduced-motion: no-preference) and (hover: hover) and (pointer: fine)", () => {
      const controller = new AbortController();
      const rotateX = gsap.quickTo(depth, "rotationX", { duration: .9, ease: "power3.out" });
      const rotateY = gsap.quickTo(depth, "rotationY", { duration: .9, ease: "power3.out" });
      section.addEventListener("pointermove", (event) => {
        if (event.pointerType === "touch") return;
        const rect = art.getBoundingClientRect();
        rotateY(Math.max(-5, Math.min(5, ((event.clientX - rect.left) / rect.width - .5) * 10)));
        rotateX(Math.max(-4, Math.min(4, (.5 - (event.clientY - rect.top) / rect.height) * 8)));
      }, { signal: controller.signal });
      const reset = () => { rotateX(0); rotateY(0); };
      section.addEventListener("pointerleave", reset, { signal: controller.signal });
      window.addEventListener("blur", reset, { signal: controller.signal });
      return () => controller.abort();
    });
  });
</script>
